    "universal-middleware": "workspace:^",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@hattip/compose": "^0.0.49",
    "@hattip/core": "catalog:",
    "@types/express": "^4 || ^5",
    "@webroute/middleware": "^0.10.0",
