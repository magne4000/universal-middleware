{
  "name": "@universal-middleware/compress",
  "version": "0.2.37",
  "type": "module",
  "description": "Universal compress middleware",
  "files": [
    "dist"
  ],
  "author": "Joël Charles <joel.charles91@gmail.com>",
  "repository": "https://github.com/magne4000/universal-middleware",
