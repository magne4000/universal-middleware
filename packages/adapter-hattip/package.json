{
  "name": "@universal-middleware/hattip",
  "version": "0.5.2",
  "type": "module",
  "description": "Hattip adapter for universal middlewares",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "author": "Joël Charles <joel.charles91@gmail.com>",
  "repository": "https://github.com/magne4000/universal-middleware",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:run-hattip:node": "tsx tests/entry-hattip.ts",
    "test:run-hattip:bun": "bun tests/entry-hattip.ts",
    "test:run-hattip:worker": "wrangler dev tests/entry-hattip-cloudflare.ts",
    "test:run-hattip:deno": "deno run --unstable-byonm --unstable-sloppy-imports -A tests/entry-hattip.ts",
    "test:typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@universal-middleware/core": "workspace:^"
  },
  "devDependencies": {
    "@hattip/adapter-bun": "^0.0.49",
    "@hattip/adapter-cloudflare-workers": "^0.0.49",
    "@hattip/adapter-deno": "^0.0.49",
    "@hattip/adapter-node": "catalog:",
    "@hattip/compose": "^0.0.49",
    "@hattip/core": "catalog:",
    "@hattip/cors": "^0.0.49",
    "@hattip/router": "catalog:",
    "@types/node": "catalog:",
    "@universal-middleware/tests": "workspace:*",
    "@universal-middleware/tsdown-config": "workspace:*",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "peerDependencies": {
    "@hattip/compose": "^0.0.49",
    "@hattip/core": "^0.0.49",
    "@hattip/router": "^0.0.49"
  },
  "peerDependenciesMeta": {
    "@hattip/compose": {
      "optional": true
    },
    "@hattip/router": {
      "optional": true
    }
  },
  "sideEffects": false,
  "keywords": [
    "hattip",
    "universal-middleware",
    "middleware",
    "handlers",
    "server-adapters",
    "hattip-middleware",
    "universal-server",
    "context-middleware",
    "request-handling"
  ]
}
