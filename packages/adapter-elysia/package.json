{
  "name": "@universal-middleware/elysia",
  "version": "0.8.0",
  "type": "module",
  "description": "Elysia adapter for universal middlewares",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "author": "Joël Charles <joel.charles91@gmail.com>",
  "repository": "https://github.com/magne4000/universal-middleware",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:run-elysia:bun": "bun --bun tests/entry-elysia.ts",
    "test:run-elysia:worker": "wrangler dev tests/entry-elysia-cloudflare.ts",
    "test:typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@universal-middleware/core": "workspace:^"
  },
  "peerDependencies": {
    "elysia": "^1.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "catalog:",
    "@universal-middleware/tests": "workspace:*",
    "@universal-middleware/tsdown-config": "workspace:*",
    "elysia": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "sideEffects": false,
  "keywords": [
    "elysia",
    "universal-middleware",
    "middleware",
    "handlers",
    "server-adapters",
    "elysia-middleware",
    "universal-server",
    "context-middleware",
    "request-handling"
  ]
}
