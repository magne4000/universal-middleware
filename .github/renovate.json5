{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    // config:recommended without excluding folders
    ":dependencyDashboard",
    ":semanticPrefixFixDepsChoreOthers",
    "group:monorepos",
    "group:recommended",
    "replacements:all",
    "workarounds:all",

    "schedule:weekly",
    "group:allNonMajor",
    "security:minimumReleaseAgeNpm"
  ],
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "bump",
  "assignees": [
    "@magne4000"
  ],
  "ignoreDeps": [
    // manually bumping
    "node",
    "@types/node",
    "pnpm"
  ],
  "ignorePaths": [
    "**/node_modules/**",
  ],
  "postUpdateOptions": [
    "pnpmDedupe"
  ],
  "packageRules": [
    {
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      // TypeScript 7.1 is pinned to its beta: move on to its RC and release, not to the nightlies
      "matchPackageNames": ["typescript"],
      "allowedVersions": "!/-dev\\./"
    }
  ]
}
